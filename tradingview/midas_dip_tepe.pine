//@version=6
indicator("Midas Dip-Tepe", overlay = true, max_boxes_count = 200)

// Her hissede ve her periyotta (15dk, 4s) aynı ayarla çalışır; eşikler ATR katıdır, hisseye kendiliğinden uyar.
// OK   = erken dip/tepe adayı (mum kapanışında kesinleşir, sonradan silinmez).
// KUTU = kesik çizgili: canlı aday bölge (yeni dip/tepe gelirse silinir); düz çizgili: teyitli dip/tepe.
// YILAN = yeşil/kırmızı çizgi: salınım yönü. Renk değişimi = dönüş teyidi (fiyat uçtan "Salınım eşiği" kadar döndü).
// Kullanım rehberi: notes/DIP-TEPE-REHBER.pdf · test ayrıntısı: notes/DIP-TEPE.md

K0   = input.float(4.0, "Salınım eşiği (ATR katı)", minval = 1.0, step = 0.5, tooltip = "Yılanın renk değiştirmesi ve bir dip/tepenin teyidi için gereken dönüş.")
R    = input.float(0.5, "Erken ok dönüşü (ATR katı)", minval = 0.1, step = 0.05, tooltip = "Fiyat son uçtan bu kadar dönünce ok çıkar.")
G    = input.float(3.0, "En küçük bacak (ATR katı)", minval = 0.0, step = 0.5, tooltip = "Önceki dönüş noktasından bu kadar uzaklaşmadan ok çıkmaz.")
alen = input.int(14, "ATR uzunluğu", minval = 1)
showArrow = input.bool(true, "Okları göster")
showBox   = input.bool(true, "Kutuları göster")
showSnake = input.bool(true, "Yılanı göster")
showScore = input.bool(true, "Puan tablosunu köşede göster (4s + 15dk)")
tblPos    = input.string("Sağ üst", "Tablo konumu", options = ["Sağ üst", "Sağ orta", "Sağ alt", "Sol alt"])
tblGap    = input.int(1, "Tablo üst boşluğu (satır)", minval = 0, maxval = 4, tooltip = "Tablo hisse adının üstüne biniyorsa artır.")
colUp = #22c55e
colDn = #ef4444

f_leg() =>
    a = ta.atr(alen)
    var int   dir   = 0
    var float hi    = high
    var float lo    = low
    var int   hib   = bar_index
    var int   lob   = bar_index
    var bool  fired = false
    var float lastH = high
    var float lastL = low
    bool buy = false
    bool sell = false
    bool flipUp = false
    bool flipDn = false
    bool newExt = false
    if na(a)
        if high > hi
            hi := high
            hib := bar_index
        if low < lo
            lo := low
            lob := bar_index
    else
        bool proc = true
        if dir <= 0
            if low < lo
                lo := low
                lob := bar_index
                newExt := fired
                fired := false
            if not fired and close >= lo + R * a and lastH - lo >= G * a and (bar_index > lob or close > open)
                buy := true
                fired := true
            if high >= lo + K0 * a
                dir := 1
                lastL := lo
                hi := high
                hib := bar_index
                fired := false
                flipUp := true
                proc := false
        if dir >= 0 and proc
            if high > hi
                hi := high
                hib := bar_index
                newExt := fired
                fired := false
            if not fired and close <= hi - R * a and hi - lastL >= G * a and (bar_index > hib or close < open)
                sell := true
                fired := true
            if low <= hi - K0 * a
                dir := -1
                lastH := hi
                lo := low
                lob := bar_index
                fired := false
                flipDn := true
    float stop = dir > 0 ? hi - K0 * a : dir < 0 ? lo + K0 * a : na
    [dir, buy, sell, flipUp, flipDn, newExt, stop, lo, hi, lob, hib, a, fired]

// Durum kodu: 0 = aşağı, 1 = aşağı + dip adayı, 2 = yukarı + tepe adayı, 3 = yukarı
f_st() =>
    [d, _b, _s, _fu, _fd, _n, _st, _lo, _hi, _lb, _hb, _a, f] = f_leg()
    d > 0 ? (f ? 2 : 3) : d < 0 ? (f ? 1 : 0) : -1

[dir, buy, sell, flipUp, flipDn, newExt, stop, lo, hi, lob, hib, a, fired] = f_leg()

// --- Yılan ---
snakeCol = dir > 0 ? colUp : colDn
plot(showSnake and dir == dir[1] ? stop : na, "Yılan", color = snakeCol, linewidth = 2, style = plot.style_linebr)

// --- Oklar ---
plotshape(showArrow and buy,  "Dip adayı",  shape.triangleup,   location.belowbar, colUp, size = size.small)
plotshape(showArrow and sell, "Tepe adayı", shape.triangledown, location.abovebar, colDn, size = size.small)

// --- Kutular ---
var box cand = na
boxW = 3
if showBox
    if newExt or flipUp or flipDn
        box.delete(cand)
        cand := na
    if buy
        box.delete(cand)
        cand := box.new(lob - boxW, lo + a, bar_index + boxW, lo, border_color = color.new(colUp, 30), border_style = line.style_dashed, bgcolor = color.new(colUp, 88))
    if sell
        box.delete(cand)
        cand := box.new(hib - boxW, hi, bar_index + boxW, hi - a, border_color = color.new(colDn, 30), border_style = line.style_dashed, bgcolor = color.new(colDn, 88))
    if flipUp
        box.new(lob - boxW, lo + a, lob + boxW, lo, border_color = color.new(colUp, 0), bgcolor = color.new(colUp, 80))
    if flipDn
        box.new(hib - boxW, hi, hib + boxW, hi - a, border_color = color.new(colDn, 0), bgcolor = color.new(colDn, 80))

// --- Puan (0-100): 4 saatlik durum 55, 15 dakikalık durum 45 puan ---
// 4s: yalnız kapanmış 4s mumu (yeniden boyamaz). 15dk: 15dk'dan büyük grafiklerde son 15dk mumu.
stOwn = dir > 0 ? (fired ? 2 : 3) : dir < 0 ? (fired ? 1 : 0) : -1
st4r  = request.security(syminfo.tickerid, "240", f_st()[1], lookahead = barmerge.lookahead_on)
st15r = request.security(syminfo.tickerid, "15", f_st())
st4   = timeframe.period == "240" ? stOwn : st4r
st15  = timeframe.period == "15" ? stOwn : st15r
p4    = st4 == 3 ? 55 : st4 == 1 ? 25 : st4 == 2 ? 15 : 0
p15   = st15 == 3 ? 45 : st15 == 2 ? 25 : st15 == 1 ? 15 : 0
score = p4 + p15
f_txt(st) => st == 3 ? "▲ yukarı" : st == 2 ? "▲ tepe adayı" : st == 1 ? "▼ dip adayı" : st == 0 ? "▼ aşağı" : "–"
f_col(st) => st == 3 ? colUp : st == 2 ? #a3a23a : st == 1 ? #d97706 : st == 0 ? colDn : color.gray
scCol = score >= 75 ? colUp : score >= 50 ? #a3a23a : score >= 25 ? #d97706 : colDn

// --- Plan (porsiyon, 4 = tam pozisyon). Kural: puan <= 30 → 0; puan 100 → 4; puan >= 70 → en az 2;
//     4s tepe adayında en çok 2; arada elindekini koru. Test: notes/DIP-TEPE-REHBER.pdf
var int plan = 0
prevPlan = plan
if score <= 30
    plan := 0
else if score == 100
    plan := 4
else if score >= 70
    plan := math.max(plan, 2)
if st4 == 2
    plan := math.min(plan, 2)
planTxt = plan == 4 ? "Plan: 4/4 porsiyon" : plan == 2 ? "Plan: 2/4 porsiyon" : "Plan: nakit (0/4)"
planCol = plan == 4 ? colUp : plan == 2 ? #a3a23a : color.gray

pos = tblPos == "Sağ orta" ? position.middle_right : tblPos == "Sağ alt" ? position.bottom_right : tblPos == "Sol alt" ? position.bottom_left : position.top_right
var table t = table.new(pos, 1, 9)
if showScore and barstate.islast
    for k = 0 to tblGap
        if k < tblGap
            table.cell(t, 0, k, " ", text_size = size.normal)
    table.cell(t, 0, tblGap, "Puan " + str.tostring(score) + "/100", text_color = color.white, bgcolor = color.new(scCol, 10), text_size = size.normal)
    table.cell(t, 0, tblGap + 1, "4s " + f_txt(st4) + " · " + str.tostring(p4) + "/55", text_color = color.white, bgcolor = color.new(f_col(st4), 30), text_size = size.small)
    table.cell(t, 0, tblGap + 2, "15dk " + f_txt(st15) + " · " + str.tostring(p15) + "/45", text_color = color.white, bgcolor = color.new(f_col(st15), 30), text_size = size.small)
    table.cell(t, 0, tblGap + 3, planTxt, text_color = color.white, bgcolor = color.new(planCol, 20), text_size = size.small)

// --- Alarmlar: "Herhangi bir alert() fonksiyon çağrısı" seçilirse hepsi (oklar, teyitler, plan değişimi) gelir ---
tf = timeframe.period
px = str.tostring(close, format.mintick)
if buy
    alert("🟢▲ " + syminfo.ticker + " " + tf + " dip adayı · fiyat " + px + " · bozulma: " + str.tostring(lo, format.mintick) + " altı", alert.freq_once_per_bar_close)
if sell
    alert("🔴▼ " + syminfo.ticker + " " + tf + " tepe adayı · fiyat " + px + " · bozulma: " + str.tostring(hi, format.mintick) + " üstü", alert.freq_once_per_bar_close)
if flipUp
    alert("✅ " + syminfo.ticker + " " + tf + " dip teyit (yılan yeşil) · fiyat " + px, alert.freq_once_per_bar_close)
if flipDn
    alert("⛔ " + syminfo.ticker + " " + tf + " tepe teyit (yılan kırmızı) · fiyat " + px, alert.freq_once_per_bar_close)

if plan != prevPlan and barstate.isconfirmed
    alert("📋 " + syminfo.ticker + " " + planTxt + " (önce " + str.tostring(prevPlan) + "/4) · puan " + str.tostring(score) + " · fiyat " + px, alert.freq_once_per_bar_close)

alertcondition(buy,    "Dip adayı",   "{{ticker}} {{interval}} dip adayı, fiyat {{close}}")
alertcondition(sell,   "Tepe adayı",  "{{ticker}} {{interval}} tepe adayı, fiyat {{close}}")
alertcondition(flipUp, "Dip teyit",   "{{ticker}} {{interval}} dip teyit (yılan yeşil), fiyat {{close}}")
alertcondition(flipDn, "Tepe teyit",  "{{ticker}} {{interval}} tepe teyit (yılan kırmızı), fiyat {{close}}")

// Veri penceresi / doğrulama için (grafikte görünmez)
plot(buy ? 1 : 0, "buy", display = display.data_window)
plot(sell ? 1 : 0, "sell", display = display.data_window)
plot(dir, "yön", display = display.data_window)
plot(score, "puan", display = display.data_window)
plot(plan, "plan", display = display.data_window)
